{
  "name": "proveko-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Proveko — Plataforma SaaS Modular Multi-Tenant (100% TypeScript Architecture)",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "libs/*",
    "apps/*",
    "apps/control-plane/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:make:core": "npx esbuild libs/tenant-db-resolver/src/migrations.cli.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/proveko-migrations-cli.mjs && node node_modules/.cache/proveko-migrations-cli.mjs make:core",
    "db:make:client": "npx esbuild libs/tenant-db-resolver/src/migrations.cli.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/proveko-migrations-cli.mjs && node node_modules/.cache/proveko-migrations-cli.mjs make:client",
    "db:migrate:core": "npx esbuild libs/tenant-db-resolver/src/migrations.cli.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/proveko-migrations-cli.mjs && node node_modules/.cache/proveko-migrations-cli.mjs migrate:core",
    "db:migrate:clients": "npx esbuild libs/tenant-db-resolver/src/migrations.cli.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/proveko-migrations-cli.mjs && node node_modules/.cache/proveko-migrations-cli.mjs migrate:clients",
    "db:migrate:client": "npx esbuild libs/tenant-db-resolver/src/migrations.cli.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/proveko-migrations-cli.mjs && node node_modules/.cache/proveko-migrations-cli.mjs migrate:client"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "lru-cache": "^11.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
