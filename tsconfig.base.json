{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@proveko/shared-kernel": ["./libs/shared-kernel/src/index.ts"],
      "@proveko/crypto-vault": ["./libs/crypto-vault/src/index.ts"],
      "@proveko/service-guard": ["./libs/service-guard/src/index.ts"],
      "@proveko/tenant-db-resolver": ["./libs/tenant-db-resolver/src/index.ts"],
      "@proveko/event-bus": ["./libs/event-bus/src/index.ts"],
      "@proveko/rules-engine": ["./libs/rules-engine/src/index.ts"],
      "@proveko/ui-kit": ["./libs/ui-kit/src/index.ts"]
    }
  }
}
