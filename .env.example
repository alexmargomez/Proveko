# ==============================================================================
# PROVEKO — Plantilla de Entorno para Despliegue en ALpanel (ServerPanel)
# ==============================================================================
# Regla de Oro ALpanel: Cero dominios reales quemados en GitHub.
# ALpanel inyecta automáticamente APP_DOMAIN, APP_URL, FRONTEND_PORT y BACKEND_PORT
# cuando vinculas tus dominios en la pestaña "Dominios & SSL".
# ==============================================================================

# 1. Puertos del Host (Sincronizados con la Matriz de Puertos de ALpanel)
FRONTEND_PORT=5173
BACKEND_PORT=4000
DB_EXTERNAL_PORT=5432

# 2. Dominios y URLs (Neutros por defecto; gestionados desde ALpanel -> Dominios & SSL)
APP_DOMAIN=localhost
APP_URL=http://localhost:4000
ALLOWED_HOSTS=localhost,127.0.0.1,api-gateway

# 3. Base de Datos PostgreSQL (Base Maestra de Control + Bases Independientes por Cliente: Base A, Base B, Base C...)
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=proveko_control_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=proveko_master_secret_2026

# 4. Seguridad Zero-Trust Ed25519 + Sello HMAC-SHA256 de Clúster (Gateway -> Microservicio Interno/Externo)
JWT_ACTIVE_KID=kid-proveko-cluster-2026
JWT_MASTER_SEED=proveko_alpanel_ed25519_master_seed_2026
PROVEKO_CLUSTER_SECRET=proveko_alpanel_cluster_hmac_secret_2026

# 5. Topología de Microservicios Independientes (Apuntan a contenedores locales o a otros VPS cuando crece el tráfico)
UPSTREAM_MS_CRM=http://ms-crm:4101
UPSTREAM_MS_INVENTORY=http://ms-inventory:4102
UPSTREAM_MS_INVOICING=http://ms-invoicing:4103
UPSTREAM_MS_GASTRO=http://ms-gastro:4104
UPSTREAM_MS_HOTEL=http://ms-hotel:4105
UPSTREAM_MS_FINANCE=http://ms-finance:4106

# 6. Filtro Opcional de Módulos Cargados por Contenedor de Microservicio (* = todos los módulos hijos del microservicio)
ENABLED_MODULES_CRM=*
ENABLED_MODULES_INVENTORY=*
ENABLED_MODULES_INVOICING=*
ENABLED_MODULES_GASTRO=*
ENABLED_MODULES_HOTEL=*
ENABLED_MODULES_FINANCE=*
